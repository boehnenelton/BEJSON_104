{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["index.ts", "Core/**/*.ts", "Gaming/**/*.ts", "Lists/**/*.ts", "Utility/**/*.ts"],
  "exclude": ["**/tests/**", "**/out/**"]
}
