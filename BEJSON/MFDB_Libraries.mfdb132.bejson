      "{\n  \"Format\": \"BEJSON\",\n  \"Format_Version\": \"104\",\n  \"Format_Creator\": \"Elton Boehnen\",\n  \"Parent_Hierarchy\": \"../104a.mfdb.bejson\",\n  \"Records_Type\": [\n    \"Metadata\"\n  ],\n  \"Fields\": [\n    {\n      \"name\": \"RECORD_TYPE\",\n      \"type\": \"string\"\n    },\n    {\n      \"name\": \"LIBRARY_FAMILY\",\n      \"type\": \"string\"\n    },\n    {\n      \"name\": \"LANGUAGE\",\n      \"type\": \"string\"\n    },\n    {\n      \"name\": \"KEY\",\n      \"type\": \"string\"\n    },\n    {\n      \"name\": \"VALUE\",\n      \"type\": \"string\"\n    },\n    {\n      \"name\": \"DESCRIPTION\",\n      \"type\": \"string\"\n    }\n  ],\n  \"Values\": [\n    [\n      \"VERSION\",\n      \"ECOSYSTEM\",\n      \"ALL\",\n      \"CURRENT_VERSION\",\n      \"2.0.43\",\n      \"Overall library ecosystem version (bumped for 2026-08-15 registry-drift cleanup: 13 VERSION rows backfilled, families/dependencies/errors registries reconciled, Terminal_Menus error codes renumbered)\"\n    ],\n    [\n      \"VERSION\",\n      \"Core\",\n      \"PY\",\n      \"CURRENT_VERSION\",\n      \"2.4.0\",\n      \"\"\n    ],\n    [\n      \"VERSION\",\n      \"Core\",\n      \"JS\",\n      \"CURRENT_VERSION\",\n      \"2.3.0\",\n      \"\"\n    ],\n    [\n      \"VERSION\",\n      \"Core\",\n      \"TS\",\n      \"CURRENT_VERSION\",\n      \"2.4.0\",\n      \"\"\n    ],\n    [\n      \"VERSION\",\n      \"Core\",\n      \"SH\",\n      \"CURRENT_VERSION\",\n      \"1.4.0\",\n      \"\"\n    ],\n    [\n      \"VERSION\",\n      \"Core_Nesting\",\n      \"PY\",\n      \"CURRENT_VERSION\",\n      \"0.4.1\",\n      \"\"\n    ],\n    [\n      \"VERSION\",\n      \"Core_Nesting\",\n      \"JS\",\n      \"CURRENT_VERSION\",\n      \"0.4.1\",\n      \"\"\n    ],\n    [\n      \"VERSION\",\n      \"Core_Nesting\",\n      \"TS\",\n      \"CURRENT_VERSION\",\n      \"0.4.1\",\n      \"\"\n    ],\n    [\n      \"VERSION\",\n      \"Core_Nesting\",\n      \"SH\",\n      \"CURRENT_VERSION\",\n      \"0.4.1\",\n      \"\"\n    ],\n    [\n      \"VERSION\",\n      \"Cognition\",\n      \"PY\",\n      \"CURRENT_VERSION\",\n      \"1.0.0\",\n      \"\"\n    ],\n    [\n      \"VERSION\",\n      \"MD\",\n      \"PY\",\n      \"CURRENT_VERSION\",\n      \"1.1.0\",\n      \"Note: lib_bejson_MD_md_errors.py bumped to 1.2.0 on 2026-08-15 (error codes renumbered 70-79 -> 90-99 to resolve Core collision; Core is priority)\"\n    ],\n    [\n      \"RULE\",\n      \"Core\",\n      \"ALL\",\n      \"LANGUAGE_PARITY_REQUIRED\",\n      \"true\",\n      \"Core is the only family required to be implemented in parity across all four language systems (PY/JS/TS/SH). Confirmed by Elton Boehnen, 2026-07-18.\"\n    ],\n    [\n      \"RULE\",\n      \"ALL\",\n      \"ALL\",\n      \"MFDB_IS_PART_OF_CORE\",\n      \"true\",\n      \"MFDB is implemented as part of the Core family, not a separate family directory or a family requiring its own errors file. Confirmed by Elton Boehnen, 2026-07-18.\"\n    ],\n    [\n      \"RULE\",\n      \"ALL\",\n      \"ALL\",\n      \"FAMILY_OWNS_ITS_ERROR_CODES\",\n      \"true\",\n      \"Each family maintains its own lib_bejson_<Family>_bejson_errors.<ext> file. Core must not hold error codes belonging to another family.\"\n    ],\n    [\n      \"RULE\",\n      \"ALL\",\n      \"ALL\",\n      \"BEJSON_ACRONYM_DEFINITION\",\n      \"BOEHNEN ELTON JSON\",\n      \"BEJSON stands for BOEHNEN ELTON JSON. This is the sole authoritative definition; no other expansion of the acronym is valid. Confirmed by Elton Boehnen, 2026-07-21. Also stated verbatim in the header of all four Core language files (PY/JS/TS/SH).\"\n    ],\n    [\n      \"RULE\",\n      \"System\",\n      \"PY\",\n      \"PMS_DEPRECATED\",\n      \"true\",\n      \"lib_bejson_System_be_pms.py and lib_bejson_System_be_project_service.py are deprecated as of 2026-07-21 and moved to Lib_PY/System/Deprecated/. The project/package management system is being rebuilt from scratch; do not import, extend, or reference these files in new work. Confirmed by Elton Boehnen, 2026-07-21.\"\n    ],\n    [\n      \"VERSION\",\n      \"AI\",\n      \"PY\",\n      \"CURRENT_VERSION\",\n      \"3.0.1\",\n      \"\"\n    ],\n    [\n      \"VERSION\",\n      \"CMS\",\n      \"PY\",\n      \"CURRENT_VERSION\",\n      \"3.0.1\",\n      \"\"\n    ],\n    [\n      \"VERSION\",\n      \"Chunker\",\n      \"PY\",\n      \"CURRENT_VERSION\",\n      \"2.0.4\",\n      \"\"\n    ],\n    [\n      \"VERSION\",\n      \"Gaming\",\n      \"PY\",\n      \"CURRENT_VERSION\",\n      \"2.2.0\",\n      \"\"\n    ],\n    [\n      \"VERSION\",\n      \"HTML\",\n      \"PY\",\n      \"CURRENT_VERSION\",\n      \"3.1.2\",\n      \"\"\n    ],\n    [\n      \"VERSION\",\n      \"System\",\n      \"PY\",\n      \"CURRENT_VERSION\",\n      \"3.0.1\",\n      \"\"\n    ],\n    [\n      \"VERSION\",\n      \"Utility\",\n      \"PY\",\n      \"CURRENT_VERSION\",\n      \"2.4.0\",\n      \"\"\n    ],\n    [\n      \"VERSION\",\n      \"ExpCMS\",\n      \"PY\",\n      \"CURRENT_VERSION\",\n      \"6.2.0\",\n      \"\"\n    ],\n    [\n      \"VERSION\",\n      \"BEHTML\",\n      \"PY\",\n      \"CURRENT_VERSION\",\n      \"0.4.0\",\n      \"\"\n    ],\n    [\n      \"VERSION\",\n      \"BEHTML_IDE\",\n      \"PY\",\n      \"CURRENT_VERSION\",\n      \"0.1.0\",\n      \"\"\n    ],\n    [\n      \"VERSION\",\n      \"Diagrams\",\n      \"PY\",\n      \"CURRENT_VERSION\",\n      \"1.0.0\",\n      \"\"\n    ],\n    [\n      \"VERSION\",\n      \"Schedules\",\n      \"SH\",\n      \"CURRENT_VERSION\",\n      \"1.0.0\",\n      \"\"\n    ],\n    [\n      \"VERSION\",\n      \"Terminal_Menus\",\n      \"SH\",\n      \"CURRENT_VERSION\",\n      \"2.0.0\",\n      \"Bumped 1.0.0 -> 2.0.0 for the 200-206 -> 340-346 error-code renumber (breaking rename)\"\n    ]\n  ]\n}",
