      "{\n  \"Format\": \"BEJSON\",\n  \"Format_Version\": \"104\",\n  \"Format_Creator\": \"Elton Boehnen\",\n  \"Parent_Hierarchy\": \"../104a.mfdb.bejson\",\n  \"Records_Type\": [\n    \"Library_Changes\"\n  ],\n  \"Fields\": [\n    {\n      \"name\": \"LIBRARY_FAMILY\",\n      \"type\": \"string\"\n    },\n    {\n      \"name\": \"LANGUAGE\",\n      \"type\": \"string\"\n    },\n    {\n      \"name\": \"LIBRARY_FILE\",\n      \"type\": \"string\"\n    },\n    {\n      \"name\": \"CHANGE_DATE\",\n      \"type\": \"string\"\n    },\n    {\n      \"name\": \"CHANGE_DETAILS\",\n      \"type\": \"string\"\n    }\n  ],\n  \"Values\": [\n    [\n      \"MFDB\",\n      \"N/A\",\n      \"BEJSON/MFDB/104a.mfdb.bejson\",\n      \"2026-07-18\",\n      \"Rebuilt manifest: added Families entity, bumped MFDB_Version/Schema_Version\"\n    ],\n    [\n      \"MFDB\",\n      \"N/A\",\n      \"BEJSON/MFDB/data/errors.bejson\",\n      \"2026-07-18\",\n      \"Rebuilt as the global cross-family error code map; populated with Core, Core_Nesting, Cognition, MD codes across all languages\"\n    ],\n    [\n      \"MFDB\",\n      \"N/A\",\n      \"BEJSON/MFDB/data/metadata.bejson\",\n      \"2026-07-18\",\n      \"Rebuilt with LIBRARY_FAMILY+LANGUAGE granularity; added ECOSYSTEM row (2.0.41)\"\n    ],\n    [\n      \"MFDB\",\n      \"N/A\",\n      \"BEJSON/MFDB/data/library_changes.bejson\",\n      \"2026-07-18\",\n      \"Rebuilt changelog entity (this file) - now tracks LANGUAGE per entry\"\n    ],\n    [\n      \"MFDB\",\n      \"N/A\",\n      \"BEJSON/MFDB/data/families.bejson\",\n      \"2026-07-18\",\n      \"New entity: registry of every family x language combo and whether it has an owned errors file\"\n    ],\n    [\n      \"Core_Nesting\",\n      \"PY\",\n      \"lib_bejson_CoreNesting_bejson_errors.py\",\n      \"2026-07-18\",\n      \"New family error registry (v1.0.0): 130-139\"\n    ],\n    [\n      \"Core_Nesting\",\n      \"PY\",\n      \"lib_bejson_CoreNesting_bejson_core_nesting.py\",\n      \"2026-07-18\",\n      \"v0.4.1: E_NESTING_* imported from new family errors file instead of local def\"\n    ],\n    [\n      \"Core_Nesting\",\n      \"PY\",\n      \"lib_bejson_CoreNesting_bejson_nesting_query.py\",\n      \"2026-07-18\",\n      \"v0.1.1: E_NESTING_QUERY_* imported from new family errors file instead of local def\"\n    ],\n    [\n      \"Core_Nesting\",\n      \"JS\",\n      \"lib_bejson_CoreNesting_bejson_errors.js\",\n      \"2026-07-18\",\n      \"New family error registry (v1.0.0): 130-139\"\n    ],\n    [\n      \"Core_Nesting\",\n      \"JS\",\n      \"lib_bejson_CoreNesting_bejson_core_nesting.js\",\n      \"2026-07-18\",\n      \"v0.4.1: NESTING_ERRORS required from new family errors file instead of local const\"\n    ],\n    [\n      \"Core_Nesting\",\n      \"JS\",\n      \"lib_bejson_CoreNesting_bejson_nesting_query.js\",\n      \"2026-07-18\",\n      \"v0.1.1: E_NESTING_QUERY_* required from new family errors file instead of local const\"\n    ],\n    [\n      \"Core_Nesting\",\n      \"TS\",\n      \"lib_bejson_CoreNesting_bejson_errors.ts\",\n      \"2026-07-18\",\n      \"New family error registry (v1.0.0): 130-139\"\n    ],\n    [\n      \"Core_Nesting\",\n      \"TS\",\n      \"lib_bejson_CoreNesting_bejson_core_nesting.ts\",\n      \"2026-07-18\",\n      \"v0.4.1: NESTING_ERRORS imported from new family errors file instead of local const\"\n    ],\n    [\n      \"Core_Nesting\",\n      \"TS\",\n      \"lib_bejson_CoreNesting_bejson_nesting_query.ts\",\n      \"2026-07-18\",\n      \"v0.1.1: NESTING_QUERY_ERRORS imported from new family errors file instead of local const\"\n    ],\n    [\n      \"Core_Nesting\",\n      \"SH\",\n      \"lib_bejson_CoreNesting_bejson_errors.sh\",\n      \"2026-07-18\",\n      \"New family error registry (v1.0.0): 130-139\"\n    ],\n    [\n      \"Core_Nesting\",\n      \"SH\",\n      \"lib_bejson_CoreNesting_bejson_core_nesting.sh\",\n      \"2026-07-18\",\n      \"v0.4.1: sources new family errors file instead of Core's\"\n    ],\n    [\n      \"Core_Nesting\",\n      \"SH\",\n      \"lib_bejson_CoreNesting_bejson_nesting_query.sh\",\n      \"2026-07-18\",\n      \"v0.1.1: sources new family errors file instead of Core's\"\n    ],\n    [\n      \"Cognition\",\n      \"PY\",\n      \"lib_bejson_Cognition_bejson_errors.py\",\n      \"2026-07-18\",\n      \"New family error registry (v1.0.0): 270-275, 403 (SANDBOX_VIOLATION - flagged as out-of-range, kept as-is for wire compatibility)\"\n    ],\n    [\n      \"Cognition\",\n      \"PY\",\n      \"lib_bejson_Cognition_bejson_cognition.py\",\n      \"2026-07-18\",\n      \"v2.1.2: E_COGNITION_* imported from new family errors file instead of local def\"\n    ],\n    [\n      \"Core\",\n      \"PY\",\n      \"lib_bejson_Core_bejson_errors.py\",\n      \"2026-07-18\",\n      \"v2.4.0: removed Core_Nesting (130-159) and Cognition (270-289) ranges, now owned by their own families\"\n    ],\n    [\n      \"Core\",\n      \"JS\",\n      \"lib_bejson_Core_bejson_errors.js\",\n      \"2026-07-18\",\n      \"v2.3.0: removed Core_Nesting (130-159) range (moved) and Cognition (270-275) range (deleted as dead code - no Lib_JS/Cognition family exists)\"\n    ],\n    [\n      \"Core\",\n      \"TS\",\n      \"lib_bejson_Core_bejson_types.ts\",\n      \"2026-07-18\",\n      \"v2.4.0: removed CORE_NESTING_CODES block, now owned by Core_Nesting family\"\n    ],\n    [\n      \"Core\",\n      \"SH\",\n      \"lib_bejson_Core_bejson_errors.sh\",\n      \"2026-07-18\",\n      \"v1.4.0: removed Core_Nesting (130-159) range, now owned by Core_Nesting family\"\n    ],\n    [\n      \"HTML\",\n      \"PY\",\n      \"lib_bejson_HTML_bejson_diagram_validator.py\",\n      \"2026-07-18\",\n      \"v1.0.1: removed dead E_DIAGRAM_RELATIONAL_ERROR/E_DIAGRAM_INVALID_ANCHOR constants (verified unreferenced anywhere in the codebase)\"\n    ],\n    [\n      \"AI\",\n      \"PY\",\n      \"lib_bejson_AI_bejson_errors.py\",\n   